# --- Server ---
PORT=4000
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=mindbridge

# --- Optional: Claude-powered companion chat ---
# Leave the key blank to use the built-in keyword fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
